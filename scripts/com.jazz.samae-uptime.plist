<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/kimjazz</string>
		<key>PATH</key>
		<string>/Users/kimjazz/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.jazz.samae-uptime</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/kimjazz/.local/bin/samae-uptime.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>StandardErrorPath</key>
	<string>/Users/kimjazz/Library/Logs/samae/uptime.log</string>
	<key>StandardOutPath</key>
	<string>/Users/kimjazz/Library/Logs/samae/uptime.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/kimjazz</string>
</dict>
</plist>
